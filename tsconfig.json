{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"lib": ["ES2020"],
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		// import 경로에 .ts 확장자를 그대로 쓴다. 그래야 node --test가
		// 빌드 없이 src를 직접 실행할 수 있다 (webpack/babel도 문제없이 해석한다).
		"allowImportingTsExtensions": true,
		"typeRoots": ["./node_modules/@types"]
	},
	// 테스트도 타입 검사 대상이다. 가짜 ZEP(FakeZep)이 진짜 ScriptApp 시그니처와
	// 어긋나면 그 순간 잡아야지, 잘못된 가짜 위에서 초록불이 나면 테스트가
	// 오히려 해롭다.
	"include": ["main.ts", "src/**/*", "tests/**/*"],
	"exclude": ["node_modules", "res", "tools"]
}
