{
	"name": "mafia-zep",
	"version": "1.0.0",
	"description": "TypeScript 기반 마피아 게임 for ZEP",
	"overrides": {
		"chalk": "4.1.2",
		"ora": "5.4.1",
		"execa": "5.1.1"
	},
	"scripts": {
		"clean": "node tools/clean-res-js.js",
		"check:zep": "node tools/check-zep-calls.js",
		"build": "npm run clean && npm run check:zep && webpack",
		"archive": "npm run build && zep-script archive",
		"deploy": "npm run archive && zep-script publish",
		"type-check": "tsc --noEmit",
		"lint": "eslint src",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"devDependencies": {
		"@babel/cli": "^7.28.3",
		"@babel/core": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"babel-loader": "^10.0.0",
		"eslint": "^9.39.1",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"terser-webpack-plugin": "^5.3.14",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.0",
		"webpack": "^5.103.0",
		"webpack-cli": "^6.0.1",
		"zep-script": "0.16.5"
	}
}
